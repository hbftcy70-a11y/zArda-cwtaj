# BotFather'dan aldığın token
TELEGRAM_BOT_TOKEN=123456:ABC...
# https://console.anthropic.com adresinden aldığın API anahtarı
ANTHROPIC_API_KEY=sk-ant-...

# İsteğe bağlı ayarlar
BOT_NAME=Asistan
BOT_PERSONA=Samimi, meraklı ve esprili bir sohbet arkadaşısın.
# Kullanıcı bu kadar dakika yazmazsa bot kendiliğinden mesaj atar (0 = kapalı)
NUDGE_MINUTES=30
# Cevap gelmezse en fazla kaç kez üst üste kendiliğinden yazsın
MAX_NUDGES=2
# Hafızada tutulacak son mesaj sayısı
MAX_HISTORY=40
