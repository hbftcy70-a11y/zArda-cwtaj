# https://console.anthropic.com adresinden aldığın API anahtarı
ANTHROPIC_API_KEY=sk-ant-...

# --- Telegram (python main.py telegram) ---
# BotFather'dan aldığın token
TELEGRAM_BOT_TOKEN=

# --- Discord (python main.py discord) ---
# discord.com/developers > Bot > Token. "Message Content Intent" açık olmalı.
DISCORD_BOT_TOKEN=

# --- Genel HTTP API (python main.py http) ---
# İstekleri doğrulamak için uzun, rastgele bir şifre
HTTP_API_TOKEN=
HTTP_PORT=8080
# Botun kendiliğinden attığı mesajların gönderileceği adres (boşsa kapalı)
CALLBACK_URL=

# --- Davranış ---
BOT_NAME=Asistan
BOT_PERSONA=Samimi, meraklı ve esprili bir sohbet arkadaşısın.
# Kullanıcı bu kadar dakika yazmazsa bot kendiliğinden mesaj atar (0 = kapalı)
NUDGE_MINUTES=30
# Cevap gelmezse en fazla kaç kez üst üste kendiliğinden yazsın
MAX_NUDGES=2
# Hafızada tutulacak son mesaj sayısı
MAX_HISTORY=40
